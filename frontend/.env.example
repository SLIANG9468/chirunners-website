# Vite: only variables prefixed with VITE_ are exposed to the client.
#
# Local dev (`npm run dev`): leave VITE_API_BASE_URL unset. The app calls /api and /media
# on the Vite dev server; vite.config.js proxies those to Flask (127.0.0.1:5001).
# Start backend from backend/: `python run.py`
# Optional if Flask runs elsewhere:
# VITE_DEV_API_PROXY=http://127.0.0.1:5001
#
# Production build (e.g. Render static): set API URL, no trailing slash.
# VITE_API_BASE_URL=https://chirunners-api.onrender.com
