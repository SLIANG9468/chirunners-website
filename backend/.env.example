# Copy this file to `.env` and fill in your real values.
# Never commit `.env` to git.

MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Local dev only (python run.py). Render uses $PORT + gunicorn.
FLASK_PORT=5001

# Flask-Migrate CLI: `flask db upgrade` etc.
FLASK_APP=run:app

# Local default: SQLite at backend/data/app.db when unset.
# Render: paste managed Postgres DATABASE_URL from the dashboard (or blueprint).
# DATABASE_URL=

# Optional: production-style CORS. Comma-separated origins, e.g.
# https://chirunners-web.onrender.com
# Leave unset locally to allow all origins (flask-cors default).
# CORS_ORIGINS=

# Optional: base folder for Race & Volunteer per-race photo albums (subfolders = album ids).
# VOLUNTEER_RACE_ALBUMS_DIR=
