# Copy to `.env` and fill values. Do not commit `.env`.

# Optional if port 5000 is busy on your Mac
FLASK_PORT=5001
FLASK_APP=run:app

SMUGMUG_NICKNAME=
SMUGMUG_GALLERY_PATH_CHI=

# Smug og:image URL cache: unset = ~10y TTL; positive = seconds; 0 / negative / inf = until process exit
SMUGMUG_IMAGE_URL_CACHE_SECONDS=

DATABASE_URL=
