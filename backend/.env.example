# Copy this file to `.env` and fill in your real values.
# Never commit `.env` to git.

MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Local dev only (python run.py). Render uses $PORT + gunicorn.
FLASK_PORT=5001

# Optional: production-style CORS. Comma-separated origins, e.g.
# https://chirunners-web.onrender.com
# Leave unset locally to allow all origins (flask-cors default).
# CORS_ORIGINS=
